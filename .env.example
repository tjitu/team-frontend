NEXT_PUBLIC_TEAM_API_URL=http://localhost:3200/api
# Optionally override the default main site for this environment.
NEXT_PUBLIC_JITU_MAIN_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Next.js server-only account creation (/api/team/members).
# Both database URLs and this key must never use NEXT_PUBLIC_ names.
TEAM_DATABASE_URL=
JITU_CONTROL_CENTER_DATABASE_URL=
SUPABASE_SECRET_KEY=
# Optional legacy service_role JWT fallback when SUPABASE_SECRET_KEY is empty.
SUPABASE_SERVICE_ROLE_KEY=
# Optional custom database CA PEM; defaults to the official Supabase root CA.
TEAM_DATABASE_CA_PEM=
JITU_DATABASE_CA_PEM=

# Public health-check targets used by the admin Monitoring page.
# Provide full URLs; use an endpoint that returns an HTTP 2xx when healthy.
MONITOR_MAIN_URL=https://jituptn.com
MONITOR_MAIN_API_HEALTH_URL=https://jituptn.com/api/proxy/health/ready
# Optional override. Without it, the Team Platform frontend checks its own origin.
MONITOR_TEAM_URL=

# Server-only Supabase Metrics API Secret API Keys (sb_secret_...).
# Keep these out of NEXT_PUBLIC_* variables and configure them in the deployment environment.
SUPABASE_METRICS_JITU_PTN_SECRET_KEY=
SUPABASE_METRICS_TEAM_PLATFORM_SECRET_KEY=
